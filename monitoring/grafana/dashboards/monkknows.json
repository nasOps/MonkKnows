{
  "id": null,
  "uid": "monkknows-telemetry",
  "title": "MonkKnows — User Telemetry",
  "tags": ["monkknows", "product"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Registered Users",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "app_users_total{job=\"monkknows\"}", "legendFormat": "Users" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "title": "Total Searches",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "app_searches_total{job=\"monkknows\"}", "legendFormat": "Searches" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 3,
      "title": "Zero-Result Searches",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "app_search_zero_results_total{job=\"monkknows\"}", "legendFormat": "No results" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 4,
      "title": "Active Users (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "app_active_users_1d{job=\"monkknows\"}", "legendFormat": "DAU" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 10,
      "title": "Logins per Hour",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_total{job=\"monkknows\",path=\"/api/login\",code=\"200\"}[1h]))",
          "legendFormat": "Successful logins"
        },
        {
          "expr": "sum(increase(http_server_requests_total{job=\"monkknows\",path=\"/api/login\",code=\"422\"}[1h]))",
          "legendFormat": "Failed logins"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 11,
      "title": "Searches per Hour",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "increase(app_searches_total{job=\"monkknows\"}[1h])", "legendFormat": "Searches" },
        { "expr": "increase(app_search_zero_results_total{job=\"monkknows\"}[1h])", "legendFormat": "Zero results" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 20,
      "title": "Active Users — DAU / WAU / MAU",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "app_active_users_1d{job=\"monkknows\"}",  "legendFormat": "DAU (1d)" },
        { "expr": "app_active_users_7d{job=\"monkknows\"}",  "legendFormat": "WAU (7d)" },
        { "expr": "app_active_users_30d{job=\"monkknows\"}", "legendFormat": "MAU (30d)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 21,
      "title": "Inactive Users (≥30d, proxy for churn)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "app_users_total{job=\"monkknows\"} - app_active_users_30d{job=\"monkknows\"}",
          "legendFormat": "Inactive users"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 22,
      "title": "Search Result Count Distribution (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(app_search_result_count_bucket{job=\"monkknows\"}[1h])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(app_search_result_count_bucket{job=\"monkknows\"}[1h])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(app_search_result_count_bucket{job=\"monkknows\"}[1h])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
