        {
          "name": "register",
          "item": [
            {
              "name": "Register",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Response time is under 5000ms\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                      "});",
                      "",
                      "pm.test(\"Response has a JSON body\", function () {",
                      "    pm.response.to.be.json;",
                      "});",
                      "",
                      "pm.test(\"Response Content-Type is application/json\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                      "});",
                      "",
                      "if (pm.response.code === 200) {",
                      "    pm.test(\"Status code is 200\", function () {",
                      "        pm.response.to.have.status(200);",
                      "    });",
                      "    pm.test(\"Response body has statusCode property equal to 200\", function () {",
                      "        const jsonData = pm.response.json();",
                      "        pm.expect(jsonData).to.have.property(\"statusCode\");",
                      "        pm.expect(jsonData.statusCode).to.eql(200);",
                      "    });",
                      "    pm.test(\"Response body has a message property that is a string\", function () {",
                      "        const jsonData = pm.response.json();",
                      "        pm.expect(jsonData).to.have.property(\"message\");",
                      "        pm.expect(jsonData.message).to.be.a(\"string\");",
                      "    });",
                      "    pm.test(\"Message indicates successful registration\", function () {",
                      "        const jsonData = pm.response.json();",
                      "        const msg = jsonData.message.toLowerCase();",
                      "        pm.expect(msg).to.satisfy(function (m) {",
                      "            return m.includes(\"register\") || m.includes(\"success\") || m.includes(\"created\");",
                      "        }, \"Expected message to contain 'register', 'success', or 'created'\");",
                      "    });",
                      "} else if (pm.response.code === 422) {",
                      "    pm.test(\"Status code is 422\", function () {",
                      "        pm.response.to.have.status(422);",
                      "    });",
                      "    pm.test(\"Response body contains error/validation details\", function () {",
                      "        const jsonData = pm.response.json();",
                      "        const hasErrorField = jsonData.hasOwnProperty(\"error\")",
                      "            || jsonData.hasOwnProperty(\"errors\")",
                      "            || jsonData.hasOwnProperty(\"detail\")",
                      "            || jsonData.hasOwnProperty(\"message\")",
                      "            || jsonData.hasOwnProperty(\"statusCode\");",
                      "        pm.expect(hasErrorField).to.be.true;",
                      "    });",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
