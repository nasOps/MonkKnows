              "name": "Search",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Response has a data array\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.have.property(\"data\");",
                      "    pm.expect(jsonData.data).to.be.an(\"array\");",
                      "});",
                      "",
                      "pm.test(\"Data array is not empty\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.data).to.have.length.above(0);",
                      "});",
                      "",
                      "pm.test(\"Each item in data array has required fields with correct types\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    jsonData.data.forEach(function (item, index) {",
                      "        pm.expect(item, `item[${index}] should have title`).to.have.property(\"title\").that.is.a(\"string\");",
                      "        pm.expect(item, `item[${index}] should have url`).to.have.property(\"url\").that.is.a(\"string\");",
                      "        pm.expect(item, `item[${index}] should have language`).to.have.property(\"language\").that.is.a(\"string\");",
                      "        pm.expect(item, `item[${index}] should have last_updated`).to.have.property(\"last_updated\").that.is.a(\"string\");",
                      "        pm.expect(item, `item[${index}] should have content`).to.have.property(\"content\").that.is.a(\"string\");",
                      "    });",
                      "});",
                      "",
                      "pm.test(\"Response time is under 5000ms\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
