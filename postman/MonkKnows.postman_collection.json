                      "",
                      "pm.test(\"Response has a data object\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.have.property(\"data\");",
                      "    pm.expect(jsonData.data).to.be.an(\"object\");",
                      "});",
                      "",
                      "pm.test(\"data.city exists and is a string\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.data).to.have.property(\"city\");",
                      "    pm.expect(jsonData.data.city).to.be.a(\"string\");",
                      "});",
                      "",
                      "pm.test(\"data.temperature exists and is a number\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.data).to.have.property(\"temperature\");",
                      "    pm.expect(jsonData.data.temperature).to.be.a(\"number\");",
                      "});",
                      "",
                      "pm.test(\"data.humidity exists, is a number, and is between 0 and 100\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.data).to.have.property(\"humidity\");",
                      "    pm.expect(jsonData.data.humidity).to.be.a(\"number\");",
                      "    pm.expect(jsonData.data.humidity).to.be.at.least(0);",
                      "    pm.expect(jsonData.data.humidity).to.be.at.most(100);",
                      "});",
                      "",
                      "pm.test(\"data.condition exists and is a string\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.data).to.have.property(\"condition\");",
                      "    pm.expect(jsonData.data.condition).to.be.a(\"string\");",
                      "});",
                      "",
                      "pm.test(\"data.wind_speed exists and is a number\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.data).to.have.property(\"wind_speed\");",
                      "    pm.expect(jsonData.data.wind_speed).to.be.a(\"number\");",
                      "});",
                      "",
                      "pm.test(\"data.source exists and is a string\", function () {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.data).to.have.property(\"source\");",
                      "    pm.expect(jsonData.data.source).to.be.a(\"string\");",
                      "});",
                      "",
                      "pm.test(\"Response time is under 5000ms\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(5000);",
