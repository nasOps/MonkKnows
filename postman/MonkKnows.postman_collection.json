                      "if (pm.response.code === 200) {",
                      "    pm.test(\"Status code is 200\", function () {",
                      "        pm.response.to.have.status(200);",
                      "    });",
                      "    pm.test(\"Response body has a 'message' property that is a string\", function () {",
                      "        const jsonData = pm.response.json();",
                      "        pm.expect(jsonData).to.have.property(\"message\");",
                      "        pm.expect(jsonData.message).to.be.a(\"string\");",
                      "    });",
                      "    pm.test(\"Message equals 'You were logged in'\", function () {",
                      "        const jsonData = pm.response.json();",
                      "        pm.expect(jsonData.message).to.equal(\"You were logged in\");",
                      "    });",
                      "    pm.test(\"rack.session cookie is set\", function () {",
                      "        pm.expect(pm.cookies.has(\"rack.session\")).to.be.true;",
                      "    });",
                      "} else if (pm.response.code === 401) {",
                      "    pm.test(\"Status code is 401\", function () {",
                      "        pm.response.to.have.status(401);",
                      "    });",
                      "    pm.test(\"Response body contains an error or message field\", function () {",
                      "        const jsonData = pm.response.json();",
                      "        pm.expect(jsonData.hasOwnProperty(\"error\") || jsonData.hasOwnProperty(\"message\")).to.be.true;",
                      "    });",
                      "} else if (pm.response.code === 422) {",
                      "    pm.test(\"Status code is 422\", function () {",
                      "        pm.response.to.have.status(422);",
                      "    });",
                      "    pm.test(\"Response body contains validation error details\", function () {",
                      "        const jsonData = pm.response.json();",
                      "        pm.expect(jsonData.hasOwnProperty(\"errors\") || jsonData.hasOwnProperty(\"error\") || jsonData.hasOwnProperty(\"message\")).to.be.true;",
                      "    });",
                      "}"
                    ]
                  }
